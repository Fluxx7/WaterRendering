#include "shared_resources.fsl"
//#define USE_NORMALIZATION

buffer["twiddleFactors"] {
    f32x2 twiddles[];
};

buffer["fft_buffers"] {
    f32x4 fft_data[][2][MAX_CASCADES];
};

#define fft_index(x, y, b) fft_data[ x + y * N][ b ][cascade_index] 
#define fft_vindex(v, b) fft_data[ v.x + v.y * N][ b ][cascade_index]  


#define dest(index) fft_index( index , y_coord, curr_dest)
#define source(index) fft_index( index , y_coord, curr_source)

kernel[32, 1, 1] twiddleGen(id : GlobalInvocationID, u32 N) {
	if (id.x >= (N / 2)) return;
	u32 x = id.x;
	f32 theta = 2.0 * PI * f32(x) / f32(N);
	twiddles[x] = f32x2(cos(theta), sin(theta));
}

kernel[32, 32, 1] ifftStage(id : GlobalInvocationID, u32 N, u32 stage, u32 curr_source, u32 curr_dest) {
	u32 x_coord = id.x;
	u32 y_coord = id.y;
	if (x_coord >= N/2 || y_coord >= N || id.z >= MAX_CASCADES) {
		return;
	}
	const i32 cascade_index = i32(id.z);

	u32 index_base = N >> (stage + 1);
	u32 group_size = 1 << stage;
	u32 group = x_coord & ~(group_size - 1);
	u32 group_index = x_coord & (group_size - 1);
	
	// compute the indices to read from
	u32 source_index_1 = x_coord;
	u32 source_index_2 = source_index_1 + N/2;

	// compute the indices to write to
	u32 dest_index_1 = x_coord + group; 
	u32 dest_index_2 = dest_index_1 + group_size;

	// calculate the twiddle factor index to read from and retrieve that value 
	u32 twiddle_index = (source_index_1 & (group_size - 1)) * index_base;
	f32x2 twiddle = twiddles[twiddle_index];


	// load and twiddle the "odd" value, and load the "even" value
	f32x2 twiddled_x = complex_mult(twiddle, source(source_index_2).xy);
	f32x2 even_x = source(source_index_1).xy;
	f32x2 twiddled_y = complex_mult(twiddle, source(source_index_2).zw);
	f32x2 even_y = source(source_index_1).zw;
	

	// calculate the output values and write them to the determined indices
#ifdef USE_NORMALIZATION
	dest(dest_index_2) = f32x4(complex_mult(even_x - twiddled_x, 0.5), complex_mult(even_y - twiddled_y, 0.5));
	dest(dest_index_1) = f32x4(complex_mult(even_x + twiddled_x, 0.5), complex_mult(even_y + twiddled_y, 0.5));
#else
	dest(dest_index_2) = f32x4(even_x - twiddled_x, even_y - twiddled_y);
	dest(dest_index_1) = f32x4(even_x + twiddled_x, even_y + twiddled_y);
#endif
}

kernel[32, 32, 1] ifftTranspose(id : GlobalInvocationID, u32 N, u32 curr_source, u32 curr_dest) {
	u32 x_coord = id.x;
	u32 y_coord = id.y;
	if (x_coord >= N || y_coord >= N || id.z >= MAX_CASCADES) {
		return;
	}
	const i32 cascade_index = i32(id.z);
	
	fft_index(y_coord, x_coord, curr_dest) = fft_index(x_coord, y_coord, curr_source);
}


