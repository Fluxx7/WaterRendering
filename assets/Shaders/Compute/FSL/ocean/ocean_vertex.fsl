#include "../mesh/cbs_vertex_includes.fsl"
#include "shared_resources.fsl"

uniform sampler2DArray heightTexture;

uniform buffer["VertexParams"] {
	f32x4 cutoff_params; // UV.x, UV.y, v_displacement, dist_factor
};

buffer["UVBuffer"] : godot_vertex {
	f32x4[] vertex_attrs;
};

uniform buffer["PlaneInfoBuffer"] {
	f32 plane_sidelength;	
};

kernel[32, 1, 1] oceanVertex(g_id : GlobalInvocationID) {
	if (g_id.x >= num_vertices) return;
	u32 vert_index = vertex_indices[g_id.x];
	QVertex v_vert = input_vertices[vert_index];
	f32x3 vert = f32x3(q2_62_to_f32(v_vert.x), q2_62_to_f32(v_vert.y), q2_62_to_f32(v_vert.z));
	vert.xz *= plane_sidelength;
	
	f32x3 vertex_displacement = f32x3(0);
	for (i32 cascade = 0; cascade < paramsBuffer.numCascades; cascade++) {
		f32 tile_length = paramsBuffer.cascadeParams[cascade].x;
		f32x2 coords = vert.xz / tile_length;
		f32x3 tex_sample = textureLod(heightTexture, f32x3(coords, f32(cascade)), 0.0).xyz;
		vertex_displacement += tex_sample;
	}
	f32 dist_factor = clamp(exp(-(length(vert.xz - cam.camera_pos.xz) - cutoff_params.x)*cutoff_params.y), 0.05, 1.0);
	vertex_attrs[vert_index] = f32x4(vert.xz, vertex_displacement.y, dist_factor);
	vert += vertex_displacement * f32x3(1.0, dist_factor, 1.0);
	output_vertices[vert_index] = Vertex(vert.x, vert.y, vert.z);
}

#include "../double_precision.fsl"

uniform buffer["PlanetInfoBuffer"] {
	f32x3 origin;
	f32 planet_radius;	
};

f32 project_component(df32 c, df32 scale, f32 o_hi, f32 o_lo) {
	df32 d = df_sub(df_mul(c, scale), df32(o_hi, o_lo));
	return d.hi + d.lo;   // small now, so one rounding costs micrometres
}


kernel[32, 1, 1] oceanVertexPlanet(g_id : GlobalInvocationID) {
	if (g_id.x >= num_vertices) return;
	u32 vert_index = vertex_indices[g_id.x];
	QVertex v_vert = input_vertices[vert_index];
	df32 x_double = q2_62_to_df32(v_vert.x);
	df32 y_double = q2_62_to_df32(v_vert.y);
	df32 z_double = q2_62_to_df32(v_vert.z);
	// switching the projection code to double precision was handled by Claude, and 
	// I need to do a pass over it to see if any optimizations can be made because this is not 
	// good for performance right now 
	df32 len_sq = df_add(df_add(df_mul(x_double, x_double), df_mul(y_double, y_double)),
						 df_mul(z_double, z_double));
	df32 scale = df_div(df32(planet_radius, 0.0), df_sqrt(len_sq));

	f32x3 vert = f32x3(
		project_component(q2_62_to_df32(v_vert.x), scale, origin.x, 0.0),
		project_component(q2_62_to_df32(v_vert.y), scale, origin.y, 0.0),
		project_component(q2_62_to_df32(v_vert.z), scale, origin.z, 0.0));
		
	f32 dist = distance(vert, f32x3(0));
	f32x3 vertex_displacement = f32x3(0);
	for (i32 cascade = 0; cascade < paramsBuffer.numCascades; cascade++) {
		f32 tile_length = paramsBuffer.cascadeParams[cascade].x;
		f32x2 coords = vert.xz / tile_length;
		f32x3 tex_sample = textureLod(heightTexture, f32x3(coords, f32(cascade)), 0.0).xyz;
		vertex_displacement += tex_sample;
	}
	f32 dist_factor = clamp(exp(-(length(vert.xz - cam.camera_pos.xz) - cutoff_params.x)*cutoff_params.y), 0.05, 1.0);
	vertex_attrs[vert_index] = f32x4(vert.xz, vertex_displacement.y, dist_factor);
	vert = fma(vertex_displacement, f32x3(1.0, dist_factor, 1.0), vert);
	output_vertices[vert_index] = Vertex(vert.x, vert.y, vert.z);
}