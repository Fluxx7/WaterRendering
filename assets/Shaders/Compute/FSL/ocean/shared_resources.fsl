#define MAX_CASCADES 4

const f32 PI = 3.1415926535897932384626433;
const f32 g = 9.81;
const f32 water_surface_tension = 0.074;
const f32 water_density = 1000.0;


const u32 halfN: specialization_constant = 128;
const u32 N = halfN * 2;

uniform image2DArray<f32x4> spectrumMap;
uniform image2DArray<f32x4> baseSpectrum;
uniform image2DArray<f32x4> spectrumTexture;


buffer["oceanParams"] paramsBuffer{
	u32 numCascades;
	f32 windSpeed;
	f32 windDirection;
	f32 depth;
	f32 fetch;
	f32x4[] cascadeParams; // [tile length, whitecap, foam amount, unused]
};

buffer["spectrumDataBuffer"] spectrumData {
	f32 omega_peak;
};

f32 dispersion_relation(f32 k_mag, f32 depth, out f32 tan_k) {
    tan_k = tanh(k_mag * depth);
    return sqrt(g * k_mag * tan_k + pow(k_mag, 3.0) * water_surface_tension / water_density);
}

f32 dispersion_relation(f32 k_mag, f32 depth) {
    f32 tan_k = tanh(k_mag * depth);
    return sqrt(g * k_mag * tan_k + pow(k_mag, 3.0) * water_surface_tension / water_density);
}