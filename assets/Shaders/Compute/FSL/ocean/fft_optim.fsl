#include "complex.fsl"
#include "shared_resources.fsl"
// #define USE_NORMALIZATION

layout(std430) buffer twiddleFactors {
    f32x2[] twiddles;
};


// buffer shape:
// [numCascades][2][N * N]
layout(std430) buffer fft_buffers {
    f32x2[] fft_data;
};

#define fft_index(x, y) fft_data[(cascade_index * N + y ) * N + x ] 
#define fft_vindex(v) fft_index(v.x, v.y)

kernel[32, 1, 1] twiddleGen(id : GlobalInvocationID) {
	if (id.x >= halfN) return;
	u32 x = id.x;
	f32 theta = 2.0 * PI * f32(x) / f32(N);
	twiddles[x] = exp_j(theta);
}

shared f32x2[halfN] local_twiddles;
shared f32x2[2][N] local_data;

#define dest(ind) local_data[curr_dest][ind]
#define source(ind) local_data[curr_source][ind]

void ifft_stage(u32 stage, u32 curr_source, u32 curr_dest, const u32x3 coords) {
	const u32 x_coord = coords.x;
	const u32 y_coord = coords.y;
	const u32 cascade_index = coords.z;
	const u32 index_base = N >> (stage + 1);
	const u32 group_size = 1 << stage;
	const u32 group_size_mask = group_size - 1;
	const u32 group = x_coord & ~group_size_mask;
	const u32 group_index = x_coord & group_size_mask;
	
	// compute the indices to read from
	const u32 source_index_1 = x_coord;
	const u32 source_index_2 = source_index_1 + (N >> 1);

	// compute the indices to write to
	const u32 dest_index_1 = x_coord + group; 
	const u32 dest_index_2 = dest_index_1 + group_size;

	// calculate the twiddle factor index to read from and retrieve that value 
	const u32 twiddle_index = (source_index_1 & group_size_mask) * index_base;
	const f32x2 twiddle = local_twiddles[twiddle_index];


	// load and twiddle the "odd" value, and load the "even" value
	const f32x2 twiddled_x = complex_mult(twiddle, source(source_index_2));
	const f32x2 even_x = source(source_index_1);

	// calculate the output values and write them to the determined indices
#ifdef USE_NORMALIZATION
	dest(dest_index_2) = complex_mult(even_x - twiddled_x, 0.5);
	dest(dest_index_1) = complex_mult(even_x + twiddled_x, 0.5);
#else
	dest(dest_index_2) = even_x - twiddled_x;
	dest(dest_index_1) = even_x + twiddled_x;
#endif
}

kernel[halfN, 1, 1] ifftRow(g_id : GlobalInvocationID, l_id : LocalInvocationID, w_id : WorkGroupID) {
	if (w_id.x > 0 || w_id.y >= N || w_id.z >= MAX_CASCADES) {
		return;
	}
	u32 x_coord = g_id.x;
	u32 y_coord = g_id.y;
	const i32 cascade_index = i32(g_id.z);
	
	u32 logN = u32(findMSB(N));
	u32 curr_source = 0;
	u32 curr_dest = 1;
	local_twiddles[x_coord] = twiddles[x_coord];
	local_data[0][x_coord] = fft_index(l_id.x, g_id.y);
	local_data[0][x_coord + halfN] = fft_index(l_id.x + halfN, g_id.y);
	barrier();
	
	for (u32 stage = 0u; stage < logN; stage++) {
		ifft_stage(stage, curr_source, curr_dest, u32x3(x_coord, y_coord, cascade_index));
		barrier();
		
		u32 next_dest = curr_source;
		curr_source = curr_dest;
		curr_dest = next_dest;
	}

	fft_index(l_id.x, g_id.y) = local_data[curr_source][x_coord];
	fft_index(l_id.x + halfN, g_id.y) = local_data[curr_source][x_coord + halfN];
}

kernel[halfN, 1, 1] ifftColumn(g_id : GlobalInvocationID, l_id : LocalInvocationID, w_id : WorkGroupID) {
	if (w_id.x > 0 || w_id.y >= N || w_id.z >= MAX_CASCADES) {
		return;
	}
	u32 x_coord = g_id.x;
	u32 y_coord = g_id.y;
	const i32 cascade_index = i32(g_id.z);
	
	u32 logN = u32(findMSB(N));
	u32 curr_source = 0;
	u32 curr_dest = 1;
	local_twiddles[x_coord] = twiddles[x_coord];
	local_data[0][x_coord] = fft_index(g_id.y, l_id.x);
	local_data[0][x_coord + halfN] = fft_index(g_id.y, l_id.x + halfN);
	barrier();
	for (u32 stage = 0u; stage < logN; stage++) {
		ifft_stage(stage, curr_source, curr_dest, u32x3(x_coord, y_coord, cascade_index));
		barrier();
		
		u32 next_dest = curr_source;
		curr_source = curr_dest;
		curr_dest = next_dest;
	}
	fft_index(g_id.y, l_id.x) = local_data[curr_source][x_coord];
	fft_index(g_id.y, l_id.x + halfN) = local_data[curr_source][x_coord + halfN];
}