#include "cbtree_defs.fsl"
#include "../mesh_common.fsl"
#include "cbs_indirect_helpers.fsl"

struct HalfEdge {
    i32 twin;
    i32 next;
    i32 prev;
    i32 vert;
    i32 edge;
    i32 face;
};

layout(std430) buffer HalfEdgeBuffer {
	u32 num_half_edges;
    HalfEdge[] half_edges;
};

struct Bisector {
	i32 state;
	i32 flags;
	i32 subdiv_pattern;
	i32 problematic_neighbor;
	i32 root_index;
    i32x3 mem_slots;
};

struct Neighbors {
	i32 prev;
	i32 next;
	i32 twin;	
};

layout(std430) buffer BisectorBuffer {
	u32 num_bisectors;
    Bisector[] bisectors;
};

layout(std430) buffer BisectorIndicesBuffer {
    i32x4[] bisector_indices;
};

layout(std430) buffer BisectorIDBuffer {
    u64[] bisector_ids;
};

layout(std430) buffer NeighborsBuffer {
	Neighbors[] neighbors;
};

layout(std430) buffer NeighborsCopyBuffer {
	Neighbors[] neighbors_copy;
};

layout(std430) buffer SplitBisectors {
	u32 count;
	i32[] indices;
} splitBisectors;

layout(std430) buffer AllocatingBisectors {
	u32 count;
	i32[] indices;
} allocatingBisectors;

layout(std430) buffer MergeBisectors {
	u32 count;
	i32[] indices;
} mergeBisectors;

layout(std430) buffer SimplifyingBisectors {
	u32 count;
	i32[] indices;
} simplifyingBisectors;

layout(std430) buffer PropagatingBisectors {
	u32 count_split;
	u32 count_merge;
	i32[] indices;
} propagatingBisectors;

layout(std430) buffer ModifiedBisectors {
	u32 count;
	i32[] indices;
} modifiedBisectors;


f32x3 vertex_to_f32x3(Vertex vertex) {
	return f32x3(vertex.x, vertex.y, vertex.z);
}

Vertex f32x3_to_vertex(f32x3 vertex_src) {
	return Vertex(vertex_src.x, vertex_src.y, vertex_src.z);	
}

#define SPLIT_TWIN 1
#define SPLIT_PREV 2
#define SPLIT_NEXT 4

#define STATE_UNCHANGED 0
#define STATE_BISECT 1
#define STATE_SIMPLIFY 2
#define STATE_MERGED 3

#define FLAG_NONE 0
#define FLAG_UPDATE 1
#define FLAG_SMALLEST 2

bool _true() {
	return 1 == 1;	
}

bool _false() {
	return 1 == 0;	
}

// stupid hack until I add boolean literals
#define true _true()
#define false _false()

bool has_flag(i32 command, i32 flag) {
	return (command & flag) != 0;	
}

i32 get_nth_high_bit(u32 index) {
	i32 bitID = 1;
	while (bitID < cbt_capacity) {
		bitID *= 2;
		if (index >= cbtree.data[bitID]) {
			index -= cbtree.data[bitID];
			bitID++;
		}
	}
	return bitID - i32(cbt_capacity);
}


i32 get_depth(u64 b_id) {
	return i32(findMSB(b_id) - id_depth_offset);
}

i32 load_depth(i32 b_index) {
	return get_depth(bisector_ids[b_index]);
}


f32x3x3 bisector_vertices(i32 b_index) {
	i32x4 indices = bisector_indices[b_index];
	f32x3 v0 = vertex_to_f32x3(vertex_buffer.data[indices[0]]);
	f32x3 v1 = vertex_to_f32x3(vertex_buffer.data[indices[1]]);
	f32x3 v2 = vertex_to_f32x3(vertex_buffer.data[indices[2]]);
	return f32x3x3(v0, v1, v2);
}
