#include "cbtree_defs.fsl"
#include "../mesh_common.fsl"
#include "cbs_indirect_helpers.fsl"
#include "../halfedge/halfedge_defs.fsl"

struct Bisector {
	i32 state;
	i32 flags;
	i32 subdiv_pattern;
	i32 problematic_neighbor;
    i32x3 mem_slots;
    i32 root_index;
};

struct Neighbors {
	i32 prev;
	i32 next;
	i32 twin;	
};

buffer["VertexBitfieldBuffer"] {
	u32 num_face_verts;
	u32[] vertex_bitfield;	
};

void set_vertex_leaf(u32 leaf, u32 val) {
	vertex_bitfield[leaf] = val;
}

void set_vertex_leaf(i32 leaf, u32 val) {
	vertex_bitfield[leaf] = val;
}

u32 get_vertex_leaf(u32 leaf) {
	return vertex_bitfield[leaf];
}

u32 get_vertex_leaf(i32 leaf) {
	return vertex_bitfield[leaf];
}

buffer["VertexCountBuffer"] {
	u32 num_vertices;
	u32[] vertex_indices;
};

buffer["InternalVertexBuffer"] : godot_vertex, unrestricted {
	Vertex[] internal_vertices;
};

buffer["VertexDispatchBuffer"] vertex_dispatch : flag_indirect {
	DispatchArgs dims;	
};

buffer["BisectorBuffer"] {
	u32 num_bisectors;	
    Bisector[] bisectors;
};

buffer["BisectorIndicesBuffer"] {
    i32x4[] bisector_indices;
};

buffer["BisectorIDBuffer"] {
    u64[] bisector_ids;
};

buffer["NeighborsBuffer"] {
	Neighbors[] neighbors;
};

buffer["NeighborsCopyBuffer"] {
	Neighbors[] neighbors_copy;
};

buffer["SplitBisectors"] splitBisectors {
	u32 count;
	i32[] indices;
};

buffer["AllocatingBisectors"] allocatingBisectors {
	u32 count;
	i32[] indices;
};

buffer["MergeBisectors"] mergeBisectors {
	u32 count;
	i32[] indices;
};

buffer["SimplifyingBisectors"] simplifyingBisectors {
	u32 count;
	i32[] indices;
};

buffer["PropagatingBisectors"] propagatingBisectors {
	u32 count_split;
	u32 count_merge;
	i32[] indices;
};

#define SPLIT_TWIN 1
#define SPLIT_PREV 2
#define SPLIT_NEXT 4

#define STATE_UNCHANGED 0
#define STATE_BISECT 1
#define STATE_SIMPLIFY 2
#define STATE_MERGED 3

#define FLAG_NONE 0
#define FLAG_UPDATE 1
#define FLAG_SMALLEST 2

bool has_flag(i32 command, i32 flag) {
	return (command & flag) != 0;	
}

i32 get_nth_high_bit(u32 index) {
	i32 bitID = 1;
	while (bitID < cbt_capacity) {
		bitID *= 2;
		if (index >= cbtree.data[bitID]) {
			index -= cbtree.data[bitID];
			bitID++;
		}
	}
	return bitID - i32(cbt_capacity);
}


i32 get_depth(u64 b_id) {
	return i32(findMSB(b_id) - id_depth_offset);
}

i32 load_depth(i32 b_index) {
	return get_depth(bisector_ids[b_index]);
}


f32x4x3 bisector_vertices(i32 b_index) {
	i32x4 indices = bisector_indices[b_index];
	f32x3 v0 = vertex_to_f32x3(internal_vertices[indices[0]]);
	f32x3 v1 = vertex_to_f32x3(internal_vertices[indices[1]]);
	f32x3 v2 = vertex_to_f32x3(internal_vertices[indices[2]]);
	f32x3 vp = f32x3(0);
	if (load_depth(b_index) > 0) {
		vp = vertex_to_f32x3(internal_vertices[indices[3]]);
	}
	return f32x4x3(v0, v1, v2, vp);
}
