struct Vertex {
	f32 x;
	f32 y;
	f32 z;	
};

layout(std430) buffer VertexBuffer : godot_vertex {
	Vertex[] data;
} vertex_buffer;

struct Index {
	u32 v0;
	u32 v1;
	u32 v2;	
};

layout(std430) buffer IndexBuffer : godot_index {
	Index[] data;
} index_buffer;

layout(std430) buffer IndirectIndexedDrawCommandBuffer : flag_indirect {
	u32 index_count;
	u32 instance_count;
	u32 first_index;
	i32 vertex_offset;
	u32 first_instance;
} indexed_draw_command_buffer;

layout(std430) buffer IndirectDrawCommandBuffer : flag_indirect {
	u32 vertex_count;
	u32 instance_count;
	u32 first_vertex;
	i32 vertex_offset;
	u32 first_instance;
} draw_command_buffer;

u32 pack_uints(u32 lower, u32 upper) {
	return lower | (upper << 16);	
}