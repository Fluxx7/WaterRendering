struct Vertex {
	f32 x;
	f32 y;
	f32 z;	
};

buffer["VertexBuffer"] vertex_buffer : godot_vertex, unrestricted {
	Vertex[] data;
};

struct Index {
	u32 v0;
	u32 v1;
	u32 v2;	
};

buffer["IndexBuffer"] index_buffer : godot_index {
	Index[] data;
};

buffer["IndirectIndexedDrawCommandBuffer"] indexed_draw_command_buffer : flag_indirect {
	u32 index_count;
	u32 instance_count;
	u32 first_index;
	i32 vertex_offset;
	u32 first_instance;
};

u32 pack_uints(u32 lower, u32 upper) {
	return lower | (upper << 16);	
}


f32x3 vertex_to_f32x3(Vertex vertex) {
	return f32x3(vertex.x, vertex.y, vertex.z);
}

Vertex f32x3_to_vertex(f32x3 vertex_src) {
	return Vertex(vertex_src.x, vertex_src.y, vertex_src.z);	
}