#include "halfedge_defs.fsl"

kernel[16, 16, 1] planeMeshHalfEdge(_g_id : GlobalInvocationID, f32 sizeX, f32 sizeY, i32 edges_per_side) {
	i32x3 g_id = i32x3(_g_id);
	if (g_id.x >= edges_per_side || g_id.y >= edges_per_side) return;
	i32 max_id = edges_per_side - 1;

	i32 face = g_id.x + g_id.y * edges_per_side;
	i32 verts_per_row = edges_per_side + 1;
	
	// order: [top-left top-right bottom-right bottom-left]
	i32[4] verts;
	// order: [top right bottom left]
	i32[4] edges;
	i32[4] twins;
	
	i32 first_vert = g_id.x + g_id.y * verts_per_row;	
	verts[0] = first_vert;
	verts[1] = 1 + first_vert;
	verts[2] = 1 + first_vert + verts_per_row;	
	verts[3] = first_vert + verts_per_row;
	
	i32 first_edge = g_id.x + g_id.y * (2 * verts_per_row);
	edges[0] = first_edge;
	edges[1] = first_edge + edges_per_side + 1;
	edges[2] = g_id.x + (g_id.y + 1) * (2 * verts_per_row);
	edges[3] = first_edge + edges_per_side;
	
	twins[0] = g_id.y > 0 ? (4 * (face - edges_per_side) + 2) : -1;
	twins[1] = g_id.x < max_id ? (4 * (face + 1) + 3) : -1;
	twins[2] = g_id.y < max_id ? (4 * (face + edges_per_side)) : -1;
	twins[3] = g_id.x > 0 ? (4 * (face - 1) + 1) : -1;
	
	i32 start_id = 4 * face;
	for (i32 i = 0; i < 4; i++) {
		i32 curr_id = start_id + i;	
		HalfEdge curr_he;
		curr_he.face = face;
		curr_he.edge = edges[i];
		curr_he.vert = verts[i];
		curr_he.twin = twins[i];
		curr_he.next = i == 3 ? start_id : curr_id + 1;
		curr_he.prev = i == 0 ? start_id + 3 : curr_id - 1;
		half_edges[curr_id] = curr_he;
	}
    
    const f32x2 size = f32x2(sizeX, sizeY);
	const f32x2 step = size / f32(verts_per_row - 1);
	
	const f32 half_size = f32(verts_per_row - 1) * 0.5;
    
    f32x3 v0 = f32x3((f32(_g_id.x) - half_size) * step.y, 0.0, (f32(_g_id.y) - half_size) * step.x);
    f32x3 v1 = f32x3((f32(_g_id.x + 1) - half_size) * step.y, 0.0, (f32(_g_id.y) - half_size) * step.x);
    f32x3 v2 = f32x3((f32(_g_id.x + 1) - half_size) * step.y, 0.0, (f32(_g_id.y + 1) - half_size) * step.x);
    f32x3 v3 = f32x3((f32(_g_id.x) - half_size) * step.y, 0.0, (f32(_g_id.y + 1) - half_size) * step.x);
    
    u32 new_verts = 1;
    he_verts[verts[0]] = f32x3_to_vertex(v0);
    if (g_id.x == max_id) {
		he_verts[verts[1]] = f32x3_to_vertex(v1);
		new_verts++;
	}
	if (g_id.y == max_id) {
		he_verts[verts[3]] = f32x3_to_vertex(v3);
		new_verts++;
	}
    if (g_id == i32x3(max_id, max_id, 0)) {
		he_verts[verts[2]] = f32x3_to_vertex(v2);
		new_verts++;
	}

	atomicAdd(num_he_verts, new_verts);

	if (_g_id == u32x3(0, 0, 0)) {
		u32 num_faces = edges_per_side * edges_per_side;
		num_half_edges = 4 * num_faces;
	}
}